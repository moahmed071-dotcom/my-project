{
  "name": "mohamed-creative-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mohamed Creative OS — a personal creative productivity platform for art direction, campaigns, briefs and AI prompts.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "start": "tsx server/index.ts --production",
    "preview": "npm run build && npm start",
    "test:e2e": "npm run build && node tests/e2e.mjs && node tests/studio-e2e.mjs",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "playwright": "1.63",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20.12"
  }
}
