# Copy this file to `.env` and fill in your key. `.env` is git-ignored — never commit a real key.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: Claude model used for all generators (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: reasoning effort — low | medium | high | xhigh | max (default: high)
ANTHROPIC_EFFORT=high

# Optional: port for the API server (default: 8787). The Vite dev server proxies /api to it.
PORT=8787
